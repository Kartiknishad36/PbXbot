{
  "name": "PBX Userbot",
  "description": "Self-contained Telethon userbot by Kartiknishad36 — no external plugin download",
  "repository": "https://github.com/Kartiknishad36/PbXbot",
  "keywords": ["telegram", "userbot", "telethon", "pbx"],
  "env": {
    "APP_ID": {"description": "From my.telegram.org", "value": ""},
    "API_HASH": {"description": "From my.telegram.org", "value": ""},
    "PBXBOT_SESSION": {"description": "Telethon string session", "value": ""},
    "BOT_TOKEN": {"description": "Optional @BotFather token", "value": "", "required": false},
    "HANDLER": {"description": "Command prefix", "value": "."},
    "OWNER_ID": {"description": "Your Telegram numeric user id", "value": ""},
    "LOGGER_ID": {"description": "Log group id starting with -100", "value": "", "required": false},
    "DATABASE_URL": {"description": "Optional Postgres", "value": "", "required": false}
  },
  "buildpacks": [{"url": "heroku/python"}]
}
